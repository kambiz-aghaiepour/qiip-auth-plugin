# .env additions for the qiip server (EnvironmentFile of inference-proxy.service).
# All three OAuth values must be set together or settings validation fails.
INFERENCE_PROXY_OAUTH__CLIENT_ID=my-qiip-client
INFERENCE_PROXY_OAUTH__CLIENT_SECRET=change-me
INFERENCE_PROXY_OAUTH__REDIRECT_URI=https://your-qiip-host.localdomain/auth/callback
INFERENCE_PROXY_OAUTH__ALLOWED_DOMAINS=["localdomain"]
# TLS note: when the qiip vhost terminates TLS with a self-signed cert, the
# server-side OIDC fetches (discovery/token/userinfo) need to trust it:
#   - inference-proxy.service: Environment=SSL_CERT_FILE=/etc/pki/tls/certs/<host>.pem
#   - uvicorn args: --proxy-headers (so X-Forwarded-Proto https is honored)
